{
  "name": "nishkarsh",
  "version": "0.1.0",
  "private": true,
  "description": "Nishkarsh \u2014 pilot-to-procurement evidence and contracting layer (PS 26136)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @nishkarsh/api\" \"npm run dev -w @nishkarsh/web\"",
    "db:migrate": "npm run db:migrate -w @nishkarsh/api",
    "db:seed": "npm run db:seed -w @nishkarsh/api",
    "db:reset": "npm run db:reset -w @nishkarsh/api",
    "demo:pilot": "node scripts/demo-pilot.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
