DATABASE_URL="postgresql://YOUR_USER@localhost:5432/nishkarsh"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Enables one-click role switching for local demos. Passwordless: fictional data only.
# In production the server refuses to start with this on unless ALLOW_PUBLIC_DEMO=true is also set (see docs/deploy.md).
DEMO_MODE=true
# Stage 1 AI drafting assistant (optional). Without a key the assistant runs in offline keyword-rules mode.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5

# --- Deployed instances only (see docs/deploy.md) ---
# NODE_ENV=production            # JWT_SECRET must then be 32+ characters (openssl rand -base64 48)
# ALLOW_PUBLIC_DEMO=true         # confirm that DEMO_MODE on a public URL is a fictional-data demo
# AUTO_SEED=true                 # load demo data on first boot of an empty database
# AUTO_DEMO_PILOT=true           # ...and replay the demo storyline
# CORS_ORIGIN=https://example.org  # only for a split web/API deployment; unset = same origin
